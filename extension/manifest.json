{
  "manifest_version": 3,
  "name": "Agent360 Browser MCP",
  "version": "2.4.40",
  "description": "Control your real Chrome from Claude Code — navigate, click, fill, screenshot, batch, refs, find, record and replay. 54 tools, multi-session, multi-browser.",
  "key": "",
  "update_url": "https://makingmofongo.github.io/browser-mcp-dist/updates.xml",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "console-capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "permissions": [
    "tabs",
    "tabGroups",
    "cookies",
    "scripting",
    "activeTab",
    "storage",
    "alarms",
    "offscreen",
    "notifications",
    "webNavigation",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https: http: ws://127.0.0.1:* http://127.0.0.1:*"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  }
}
